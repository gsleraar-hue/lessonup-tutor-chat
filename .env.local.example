ANTHROPIC_API_KEY=sk-ant-...
# Optioneel, default is claude-sonnet-5
ANTHROPIC_MODEL=claude-sonnet-5

# Optioneel: pad naar een lokale Piper-installatie (binary + voices/-map).
# Default is /opt/piper, wat de Dockerfile installeert. Lokaal draaien
# zonder Piper werkt ook prima, dan geeft de "voorlezen"-knop alleen een
# foutmelding i.p.v. geluid.
PIPER_DIR=/opt/piper
